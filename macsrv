#!/bin/zsh

STATE_DIR="$HOME/.macsrv"
PID_FILE="$STATE_DIR/pid"
START_FILE="$STATE_DIR/started"
EXPIRE_FILE="$STATE_DIR/expires"

mkdir -p "$STATE_DIR"

TARGET_HOUR=2
TARGET_MINUTE=0

seconds_until_target() {
    now=$(date +%s)

    target=$(date -v${TARGET_HOUR}H -v${TARGET_MINUTE}M -v0S +%s)

    if [[ $target -le $now ]]; then
        target=$(date -v+1d -v${TARGET_HOUR}H -v${TARGET_MINUTE}M -v0S +%s)
    fi

    echo $((target-now))
}

cleanup() {
    rm -f "$PID_FILE" "$START_FILE" "$EXPIRE_FILE"
}

status() {

    if [[ ! -f "$PID_FILE" ]]; then
        echo "⚫ Mac Server: OFF"
        exit 0
    fi

    PID=$(cat "$PID_FILE")

    if ! kill -0 "$PID" 2>/dev/null; then
        cleanup
        echo "⚫ Mac Server: OFF"
        exit 0
    fi

    NOW=$(date +%s)
    EXPIRE=$(cat "$EXPIRE_FILE")
    REMAIN=$((EXPIRE-NOW))

    if [[ $REMAIN -lt 0 ]]; then
        REMAIN=0
    fi

    H=$((REMAIN/3600))
    M=$(((REMAIN%3600)/60))

    echo "🟢 Mac Server: ON"
    echo
    echo "PID       : $PID"
    echo "Started   : $(cat "$START_FILE")"
    echo "Expires   : $(date -r "$EXPIRE" '+%Y-%m-%d %H:%M')"
    echo "Remaining : ${H}h ${M}m"
}

start() {

    if [[ -f "$PID_FILE" ]]; then

        PID=$(cat "$PID_FILE")

        if kill -0 "$PID" 2>/dev/null; then
            echo "✅ Already running."
            exit 0
        fi

        cleanup
    fi

    DURATION=$(seconds_until_target)

    EXPIRE=$(($(date +%s)+DURATION))

    nohup caffeinate -dimsu -t "$DURATION" >/dev/null 2>&1 &

    PID=$!

    echo "$PID" > "$PID_FILE"
    date '+%Y-%m-%d %H:%M' > "$START_FILE"
    echo "$EXPIRE" > "$EXPIRE_FILE"

    echo "🚀 Mac Server started."
    echo
    echo "Expires at: $(date -r "$EXPIRE" '+%Y-%m-%d %H:%M')"
}

stop() {

    if [[ ! -f "$PID_FILE" ]]; then
        echo "💤 Already stopped."
        exit 0
    fi

    PID=$(cat "$PID_FILE")

    kill "$PID" 2>/dev/null

    cleanup

    echo "💤 Mac Server stopped."
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    status)
        status
        ;;
    *)
        echo "Usage:"
        echo
        echo "  macsrv start"
        echo "  macsrv stop"
        echo "  macsrv status"
        exit 1
        ;;
esac
